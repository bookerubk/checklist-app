# ============================================================
# CheckList-1С — TEST deploy env (Yandex Cloud)
# Copy to deploy/test/.env.test and fill values.
# NEVER commit real secrets.
# ============================================================

# --- Yandex Cloud ---
YC_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
YC_REGISTRY_ID=crpxxxxxxxxxxxxxxxx
YC_SERVICE_ACCOUNT_ID=ajexxxxxxxxxxxxxxxx
YC_ZONE=ru-central1-a

# Image / container names (test suffix)
IMAGE_NAME=checklist-webapp
IMAGE_TAG=test
CONTAINER_NAME=checklist-webapp-test
# Registry image path will be:
#   cr.yandex/${YC_REGISTRY_ID}/${IMAGE_NAME}:${IMAGE_TAG}

# Container resources (test = cheap)
CORES=1
MEMORY=512MB
CONCURRENCY=4
EXECUTION_TIMEOUT=30s
MIN_INSTANCES=0

# App runtime env injected into container revision
NODE_ENV=production
APP_ENV=test
PORT=8080
VITE_SHOW_DEMO_PROFILES=true

# YDB Cloud Function HTTP invoke URL (API Gateway or function HTTPS)
# Frontend posts to /api/query → server proxies here
YDB_FUNCTION_URL=https://functions.yandexcloud.net/<function-id>
YDB_PROXY_TIMEOUT_MS=25000
# true for open test; set false + JWT later
ALLOW_UNAUTH_API=true

# Optional MinIO / S3 (no secrets in git — only via this file / Lockbox)
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=

# Optional public app URL (for QR deep-links later)
APP_URL=

# --- YDB Cloud Function (for deploy-ydb-fn.sh) ---
YDB_FN_NAME=checklist-ydb-proxy-test
ADMIN_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
ADMIN_YDB_DATABASE=/ru-central1/<folder>/<db-admin>
CLIENT_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
CLIENT_YDB_DATABASE=/ru-central1/<folder>/<db-client>
