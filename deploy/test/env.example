# ============================================================
# CheckList-1С — TEST deploy (Cloud Functions ONLY)
# cp deploy/test/env.example deploy/test/.env.test
# NEVER commit .env.test
# ============================================================

# --- Yandex Cloud ---
YC_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
YC_SERVICE_ACCOUNT_ID=ajexxxxxxxxxxxxxxxx

# --- Object Storage for CF packages (>3.5MB direct upload limit) ---
# Required for ydb-function (ydb sdk zip is typically 10–40MB).
# Bucket is auto-created if missing (SA needs storage admin/uploader).
CF_PACKAGE_BUCKET=checklist-cf-packages-test
CF_PACKAGE_PREFIX=cf-packages
# CF_DIRECT_UPLOAD_MAX_BYTES=3500000

# --- Webapp Cloud Function ---
WEBAPP_FN_NAME=checklist-webapp-test
WEBAPP_FN_RUNTIME=nodejs18
WEBAPP_FN_MEMORY=512m
WEBAPP_FN_TIMEOUT=30s
APP_ENV=test
VITE_SHOW_DEMO_PROFILES=true
ALLOW_UNAUTH_API=true
YDB_PROXY_TIMEOUT_MS=25000
CORS_ORIGIN=*
# WEBAPP_PUBLIC_URL=https://xxxxxx.apigw.yandexcloud.net
DEPLOY_APIGW=1
APIGW_NAME=checklist-webapp-test-gw

# --- YDB Cloud Function ---
YDB_FN_NAME=checklist-ydb-proxy-test
YDB_FUNCTION_URL=
# After deploy-ydb-fn.sh:
# YDB_FUNCTION_URL=https://functions.yandexcloud.net/<ydb-fn-id>

ADMIN_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
ADMIN_YDB_DATABASE=/ru-central1/<folder>/<db-admin>
CLIENT_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
CLIENT_YDB_DATABASE=/ru-central1/<folder>/<db-client>

# Optional MinIO
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=
APP_URL=
