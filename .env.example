# Local / container runtime
NODE_ENV=development
PORT=8080
APP_ENV=local

# Gemini (AI Studio leftover — optional, not required for checklist UI)
GEMINI_API_KEY=

# Public URL (QR deep-links)
APP_URL=http://localhost:3000

# Demo profiles switch in ManagerLoginModal
VITE_SHOW_DEMO_PROFILES=true

# YDB Cloud Function HTTP URL — server.js proxies POST /api/query here
YDB_FUNCTION_URL=
YDB_PROXY_TIMEOUT_MS=25000
ALLOW_UNAUTH_API=true
