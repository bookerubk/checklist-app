+  fi
+else
+  # must look like JSON with columns or success
+  if ! grep -qE '"success":\s*true|"columns"' /tmp/smk-q.out 2>/dev/null; then
+    echo "  FAIL /api/query body unexpected"
+    fail=1
+  else
+    echo "  OK  POST /api/query body"
+  fi
+fi
 
