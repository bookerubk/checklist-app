From: checklist-patch
Subject: [PATCH] CF-only deploy + Object Storage for packages >3.5MB

diff --git a/deploy/test/cf-package-source.sh b/deploy/test/cf-package-source.sh
new file mode 100755
index 0000000..1111111
--- /dev/null
+++ b/deploy/test/cf-package-source.sh
@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+# Resolve how to pass a zip to `yc serverless function version create`.
+#
+# Yandex direct --source-path limit: 3.5 MB.
+# Larger packages MUST go via Object Storage:
+#   --package-bucket-name + --package-object-name
+#
+# Usage:
+#   source deploy/test/cf-package-source.sh
+#   CF_VERSION_SOURCE_ARGS=( $(cf_package_source_args /path/to.zip ydb-proxy) )
+#   yc serverless function version create ... "${CF_VERSION_SOURCE_ARGS[@]}"
+#
+# Requires env (from load-env / .env.test):
+#   YC_FOLDER_ID
+#   CF_PACKAGE_BUCKET   (Object Storage bucket name)
+# Optional:
+#   CF_PACKAGE_PREFIX   (default: cf-packages)
+#   CF_DIRECT_UPLOAD_MAX_BYTES (default: 3500000)
+
+cf_package_source_args() {
+  local zip_path="$1"
+  local object_slug="${2:-package}"
+
+  if [[ ! -f "$zip_path" ]]; then
+    echo "❌ zip not found: $zip_path" >&2
+    return 1
+  fi
+
+  local size
+  size=$(wc -c < "$zip_path" | tr -d ' ')
+  local max="${CF_DIRECT_UPLOAD_MAX_BYTES:-3500000}"
+
+  echo "📦 package: $zip_path ($(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "${size} bytes"))" >&2
+
+  if [[ "$size" -le "$max" ]]; then
+    echo "   ≤ 3.5MB → direct --source-path" >&2
+    echo --source-path
+    echo "$zip_path"
+    return 0
+  fi
+
+  echo "   > 3.5MB → Object Storage upload required" >&2
+
+  local bucket="${CF_PACKAGE_BUCKET:-}"
+  if [[ -z "$bucket" ]]; then
+    echo "❌ Zip is larger than 3.5MB. Set CF_PACKAGE_BUCKET in deploy/test/.env.test" >&2
+    echo "   Example:" >&2
+    echo "     CF_PACKAGE_BUCKET=checklist-cf-packages-test" >&2
+    echo "   Create bucket once:" >&2
+    echo "     yc storage bucket create --name checklist-cf-packages-test --folder-id \"\$YC_FOLDER_ID\"" >&2
+    echo "   SA needs roles: storage.uploader (or storage.editor) on the bucket/folder" >&2
+    return 1
+  fi
+
+  : "${YC_FOLDER_ID:?YC_FOLDER_ID required for bucket ensure}"
+
+  # ensure bucket exists
+  if ! yc storage bucket get --name "$bucket" >/dev/null 2>&1; then
+    echo "=== create Object Storage bucket: $bucket ===" >&2
+    yc storage bucket create \
+      --name "$bucket" \
+      --folder-id "$YC_FOLDER_ID" \
+      --default-storage-class standard \
+      --max-size 10737418240 \
+      >/dev/null
+    echo "   bucket created" >&2
+  else
+    echo "   bucket exists: $bucket" >&2
+  fi
+
+  local prefix="${CF_PACKAGE_PREFIX:-cf-packages}"
+  local ts
+  ts=$(date -u +%Y%m%dT%H%M%SZ)
+  local key="${prefix}/${object_slug}/${ts}-$(basename "$zip_path")"
+
+  echo "=== upload s3://${bucket}/${key} ===" >&2
+  # yc storage cp works for Object Storage
+  if yc storage cp "$zip_path" "s3://${bucket}/${key}" --folder-id "$YC_FOLDER_ID" 2>/dev/null; then
+    :
+  else
+    # fallback s3api
+    yc storage s3api put-object \
+      --bucket "$bucket" \
+      --key "$key" \
+      --body "$zip_path" \
+      >/dev/null
+  fi
+
+  echo "   uploaded OK" >&2
+  echo --package-bucket-name
+  echo "$bucket"
+  echo --package-object-name
+  echo "$key"
+}
+
+# Read args into array helper for bash callers
+#   mapfile -t CF_VERSION_SOURCE_ARGS < <(cf_package_source_args "$zip" "ydb")
+# Note: mapfile keeps newlines; we echo one flag/value per line.
diff --git a/deploy/test/deploy-ydb-fn.sh b/deploy/test/deploy-ydb-fn.sh
new file mode 100755
index 0000000..1111111
--- /dev/null
+++ b/deploy/test/deploy-ydb-fn.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Deploy YDB proxy Cloud Function (TEST)
+# Packages with @ydbjs/* usually exceed 3.5MB → Object Storage path.
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+# shellcheck disable=SC1091
+source "$ROOT_DIR/deploy/test/load-env.sh"
+# shellcheck disable=SC1091
+source "$ROOT_DIR/deploy/test/cf-package-source.sh"
+
+: "${YDB_FN_NAME:=checklist-ydb-proxy-test}"
+: "${YDB_FN_RUNTIME:=nodejs18}"
+: "${YDB_FN_ENTRYPOINT:=index.handler}"
+: "${YDB_FN_MEMORY:=256m}"
+: "${YDB_FN_TIMEOUT:=15s}"
+
+: "${ADMIN_YDB_ENDPOINT:?Set ADMIN_YDB_ENDPOINT in .env.test}"
+: "${ADMIN_YDB_DATABASE:?Set ADMIN_YDB_DATABASE in .env.test}"
+: "${CLIENT_YDB_ENDPOINT:?Set CLIENT_YDB_ENDPOINT in .env.test}"
+: "${CLIENT_YDB_DATABASE:?Set CLIENT_YDB_DATABASE in .env.test}"
+
+FN_DIR="$ROOT_DIR/ydb-function"
+WORK_DIR=$(mktemp -d)
+trap 'rm -rf "$WORK_DIR"' EXIT
+
+echo "=== pack function ==="
+cp "$FN_DIR/index.js" "$FN_DIR/package.json" "$WORK_DIR/"
+(
+  cd "$WORK_DIR"
+  npm install --omit=dev --no-audit --no-fund
+
+  # slim zip: drop junk from node_modules (still often >3.5MB with ydb sdk)
+  zip -qr function.zip index.js package.json package-lock.json node_modules \
+    -x "node_modules/*/.git/*" \
+    -x "node_modules/*/test/*" \
+    -x "node_modules/*/tests/*" \
+    -x "node_modules/*/*/test/*" \
+    -x "node_modules/**/docs/*" \
+    -x "node_modules/**/*.md" \
+    -x "node_modules/**/*.ts" \
+    -x "node_modules/**/tsconfig.json" \
+    -x "node_modules/**/*.map" \
+    -x "node_modules/**/example/*" \
+    -x "node_modules/**/examples/*" \
+    -x "node_modules/**/.github/*"
+)
+
+ZIP_PATH="$WORK_DIR/function.zip"
+ls -lh "$ZIP_PATH"
+
+echo "=== resolve package source (direct vs Object Storage) ==="
+mapfile -t CF_VERSION_SOURCE_ARGS < <(cf_package_source_args "$ZIP_PATH" "ydb-proxy")
+if [[ ${#CF_VERSION_SOURCE_ARGS[@]} -lt 2 ]]; then
+  echo "❌ failed to resolve package source"
+  exit 1
+fi
+echo "   yc args: ${CF_VERSION_SOURCE_ARGS[*]}"
+
+echo "=== ensure function exists ==="
+if ! yc serverless function get --name "$YDB_FN_NAME" --folder-id "$YC_FOLDER_ID" >/dev/null 2>&1; then
+  yc serverless function create --name "$YDB_FN_NAME" --folder-id "$YC_FOLDER_ID"
+fi
+
+echo "=== create version ==="
+yc serverless function version create \
+  --function-name "$YDB_FN_NAME" \
+  --folder-id "$YC_FOLDER_ID" \
+  --runtime "$YDB_FN_RUNTIME" \
+  --entrypoint "$YDB_FN_ENTRYPOINT" \
+  --memory "$YDB_FN_MEMORY" \
+  --execution-timeout "$YDB_FN_TIMEOUT" \
+  --service-account-id "$YC_SERVICE_ACCOUNT_ID" \
+  "${CF_VERSION_SOURCE_ARGS[@]}" \
+  --environment "ADMIN_YDB_ENDPOINT=${ADMIN_YDB_ENDPOINT}" \
+  --environment "ADMIN_YDB_DATABASE=${ADMIN_YDB_DATABASE}" \
+  --environment "CLIENT_YDB_ENDPOINT=${CLIENT_YDB_ENDPOINT}" \
+  --environment "CLIENT_YDB_DATABASE=${CLIENT_YDB_DATABASE}"
+
+echo "=== allow unauthenticated invoke (TEST only) ==="
+yc serverless function allow-unauthenticated-invoke "$YDB_FN_NAME" --folder-id "$YC_FOLDER_ID" || true
+
+FN_ID=$(yc serverless function get --name "$YDB_FN_NAME" --folder-id "$YC_FOLDER_ID" --format json | jq -r '.id')
+FN_URL="https://functions.yandexcloud.net/${FN_ID}"
+
+# auto-write hint file for next steps
+echo "$FN_URL" > "$ROOT_DIR/deploy/test/.last-ydb-url"
+echo "$FN_ID" > "$ROOT_DIR/deploy/test/.last-ydb-id"
+
+echo ""
+echo "========================================="
+echo "✅ TEST YDB function deployed"
+echo "ID:  $FN_ID"
+echo "URL: $FN_URL"
+echo ""
+echo "Add to deploy/test/.env.test:"
+echo "  YDB_FUNCTION_URL=$FN_URL"
+echo "Then: npm run deploy:test:webapp"
+echo "========================================="
diff --git a/deploy/test/deploy-webapp-cf.sh b/deploy/test/deploy-webapp-cf.sh
