+# ============================================================
+# CheckList-1С — TEST deploy (Cloud Functions ONLY)
+# cp deploy/test/env.example deploy/test/.env.test
+# NEVER commit .env.test
+# ============================================================
+
+# --- Yandex Cloud ---
+YC_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
+YC_SERVICE_ACCOUNT_ID=ajexxxxxxxxxxxxxxxx
+
+# --- Object Storage for CF packages (>3.5MB direct upload limit) ---
+# Required for ydb-function (ydb sdk zip is typically 10–40MB).
+# Bucket is auto-created if missing (SA needs storage admin/uploader).
+CF_PACKAGE_BUCKET=checklist-cf-packages-test
+CF_PACKAGE_PREFIX=cf-packages
+# CF_DIRECT_UPLOAD_MAX_BYTES=3500000
+
+# --- Webapp Cloud Function ---
+WEBAPP_FN_NAME=checklist-webapp-test
+WEBAPP_FN_RUNTIME=nodejs18
+WEBAPP_FN_MEMORY=512m
